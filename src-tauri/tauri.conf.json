{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "will-remote",
  "version": "0.1.0",
  "identifier": "com.wiliammp.will-remote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "will-remote",
        "width": 900,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://0.peerjs.com wss://0.peerjs.com; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["PortugueseBR"], "installMode": "currentUser" }
    }
  }
}
